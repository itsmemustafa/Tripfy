# ───────────────────────────────────────────────
#  Tripfy — Root .gitignore  (single authority)
#  Child .gitignores only add package-local rules
# ───────────────────────────────────────────────

# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/
out/
.next/

# Environment files (ALL patterns, all packages)
.env
.env.local
.env.development
.env.production
.env.*.local
# Allow example/template files
!.env.example
!.env.example.*

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite / tooling caches
.vite/
.vite-temp/
.cache/
.parcel-cache/
.npm/

# Runtime & uploads
server/uploads/
public/uploads/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Test outputs
coverage/
test-output/



